# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/raksha_signal?retryWrites=true&w=majority

# Google Maps API key (needs Places API + Maps JavaScript API enabled)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Server port (Render/Railway will inject their own PORT automatically)
PORT=5000
